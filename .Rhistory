})
# Show custom selection summary
output$custom_selection_summary <- renderText({
if (is.null(rv$custom_genes) || length(rv$custom_genes) == 0) {
return("No genes selected")
}
paste0("Current selection: ", length(rv$custom_genes), " genes")
})
# Analyze custom selection (redirect to on-demand enrichment tab)
observeEvent(input$analyze_custom, {
req(rv$custom_genes, length(rv$custom_genes) > 0)
# Switch to on-demand enrichment tab
updateTabItems(session, "sidebarMenu", "ondemand_enrichment")
# Set up on-demand enrichment with custom genes
# You'll need to add functionality to analyze the custom gene set
})
observeEvent(input$analyze_custom, {
req(rv$custom_genes, length(rv$custom_genes) > 0)
# Switch to on-demand enrichment tab
updateTabItems(session, "sidebarMenu", "ondemand_enrichment")
# Set gene source to Custom Selection
updateSelectInput(session, "gene_source", selected = "Custom Selection")
})
# Handle export action
observeEvent(input$do_export, {
req(rv$current_mutation, rv$current_cluster, input$export_approach, input$export_type)
# Close the modal
removeModal()
# Get cluster data for current selection
cluster_key <- paste0("cluster_", rv$current_cluster)
cluster_data <- results[[rv$current_mutation]][[cluster_key]]
# Extract genes based on selection
if (input$export_type == "unique") {
# Get unique genes for this approach
sig_col <- paste0(input$export_approach, "_significant")
fc_col <- paste0(input$export_approach, "_log2FC")
# Find genes significant only in this approach
unique_gene_rows <- cluster_data$comparison_data$merged[[sig_col]] &
rowSums(cluster_data$comparison_data$merged[, grepl("_significant$", colnames(cluster_data$comparison_data$merged)) &
colnames(cluster_data$comparison_data$merged) != sig_col]) == 0
genes <- cluster_data$comparison_data$merged$gene[unique_gene_rows]
fc_values <- cluster_data$comparison_data$merged[unique_gene_rows, fc_col]
p_values <- cluster_data$comparison_data$merged[unique_gene_rows, paste0(input$export_approach, "_pvalue")]
export_data <- data.frame(
Gene = genes,
Log2_Fold_Change = fc_values,
p_value = p_values,
stringsAsFactors = FALSE
)
} else {
# Get standardized data for selected approach
approach_data <- cluster_data$comparison_data$standardized[[input$export_approach]]
if (input$export_type == "up") {
filtered_data <- approach_data[approach_data$significant & approach_data$log2FC > 0, ]
} else if (input$export_type == "down") {
filtered_data <- approach_data[approach_data$significant & approach_data$log2FC < 0, ]
} else {
filtered_data <- approach_data[approach_data$significant, ]
}
export_data <- data.frame(
Gene = filtered_data$gene,
Log2_Fold_Change = filtered_data$log2FC,
p_value = filtered_data$pvalue,
stringsAsFactors = FALSE
)
}
# Sort by p-value
export_data <- export_data[order(export_data$p_value), ]
# File name prefix
file_prefix <- paste0(
"genes_", rv$current_mutation, "_cluster", rv$current_cluster,
"_", input$export_approach, "_", input$export_type
)
# Export based on format selection
if (input$export_format == "CSV") {
file_path <- file.path(tempdir(), paste0(file_prefix, ".csv"))
write.csv(export_data, file_path, row.names = FALSE)
} else if (input$export_format == "Text") {
file_path <- file.path(tempdir(), paste0(file_prefix, ".txt"))
write.table(export_data, file_path, sep = "\t", row.names = FALSE, quote = FALSE)
} else if (input$export_format == "Excel") {
file_path <- file.path(tempdir(), paste0(file_prefix, ".xlsx"))
writexl::write_xlsx(export_data, file_path)
}
# Offer download
showModal(modalDialog(
title = "Export Complete",
paste("Gene list exported to:", file_path),
footer = tagList(
downloadLink("download_exported", "Download File"),
modalButton("Close")
)
))
# Set up download handler
output$download_exported <- downloadHandler(
filename = function() {
basename(file_path)
},
content = function(file) {
file.copy(file_path, file)
}
)
})
}
# Launch the Shiny app
shinyApp(ui = ui, server = server)
}
simplify_results_for_saving <- function(results) {
simplified <- list()
for (mutation in names(results)) {
simplified[[mutation]] <- list()
for (cluster_key in names(results[[mutation]])) {
if (cluster_key == "overall_divergence") {
# Keep metrics but remove plots
simplified[[mutation]][[cluster_key]] <- list(
metrics = results[[mutation]][[cluster_key]]$metrics
)
next
}
cluster_result <- results[[mutation]][[cluster_key]]
simplified[[mutation]][[cluster_key]] <- list(
comparison_data = cluster_result$comparison_data
)
# Keep gene lists and statistics but drop plots
if (!is.null(cluster_result$venn)) {
simplified[[mutation]][[cluster_key]]$venn <- list(
sig_lists = cluster_result$venn$sig_lists,
up_lists = cluster_result$venn$up_lists,
down_lists = cluster_result$venn$down_lists,
overlap_sets = cluster_result$venn$overlap_sets
)
}
# Keep metrics but drop heatmaps
if (!is.null(cluster_result$divergence)) {
simplified[[mutation]][[cluster_key]]$divergence <- list(
jaccard_distances = cluster_result$divergence$jaccard_distances,
jaccard_similarity = cluster_result$divergence$jaccard_similarity,
concordance_metrics = cluster_result$divergence$concordance_metrics,
divergence_score = cluster_result$divergence$divergence_score,
unique_genes_percent = cluster_result$divergence$unique_genes_percent,
unique_genes = cluster_result$divergence$unique_genes
)
}
# Keep matrices but drop plots
if (!is.null(cluster_result$pathway)) {
simplified[[mutation]][[cluster_key]]$pathway <- list(
enrichment_matrix = cluster_result$pathway$enrichment_matrix,
pathway_overlaps = cluster_result$pathway$pathway_overlaps
)
}
}
}
return(simplified)
}
#####################################################
# PART 5: PIPELINE EXECUTION FUNCTION
#####################################################
#' Run the complete DE comparison pipeline
#'
#' @param approaches Named list of approach directories
#' @param output_dir Directory to save results
#' @param mutations Vector of mutations to analyze
#' @param clusters Vector of clusters to analyze
#' @param modules Vector of module names to run
#' @param pd_gene_lists Optional list of gene sets related to PD pathways
#' @param launch_app Whether to launch the Shiny app after analysis
#'
#' @return None, results are saved to disk and optionally launches the app
run_de_comparison_pipeline <- function(approaches,
output_dir = "de_comparison_results",
mutations = c("ATP13A2", "DNAJC6", "FBXO7", "GBA", "LRRK2", "PARK7",
"PINK1", "PRKN", "SNCA_A30P", "SNCA_A53T", "SYNJ1",
"VPS13C_A444P", "VPS13C_W395C"),
clusters = 0:11,
modules = c("volcano", "venn", "divergence", "pathway"),
pd_gene_lists = NULL,
precompute_enrichment = FALSE,
launch_app = TRUE) {
# Create output directory if it doesn't exist
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
# Save current working directory
old_wd <- getwd()
# Add enrichment module if precompute_enrichment is TRUE
if (precompute_enrichment) {
modules <- union(modules, "enrichment")
}
# Convert approach paths to absolute paths
absolute_approaches <- list()
for (name in names(approaches)) {
absolute_approaches[[name]] <- normalizePath(approaches[[name]], mustWork = FALSE)
cat(sprintf("Approach: %s, Directory: %s\n", name, absolute_approaches[[name]]))
}
# Run the comparison with error handling
cat("Running DE method comparison analysis...\n")
results <- tryCatch({
compare_de_approaches(
approaches = absolute_approaches,
mutations = mutations,
clusters = clusters,
modules = modules,
pd_gene_lists = pd_gene_lists,
direct_save = TRUE
)
}, error = function(e) {
cat(sprintf("Error in comparison pipeline: %s\n", e$message))
NULL
})
# Stop if no results were generated
if (is.null(results)) {
cat("No results were generated. Pipeline terminated.\n")
setwd(old_wd)
return(NULL)
}
# Change to output directory for saving results
setwd(output_dir)
# Save all results
simplified_results <- simplify_results_for_saving(results)
saveRDS(simplified_results, "all_comparison_results.rds")
# Create summary report
cat("Generating summary report...\n")
summary_report <- data.frame(
mutation = character(),
cluster = character(),
num_approaches = integer(),
jaccard_avg = numeric(),
divergence_score = numeric(),
stringsAsFactors = FALSE
)
# Generate summary with error handling
tryCatch({
for (mutation in names(results)) {
mutation_result <- results[[mutation]]
for (cluster_key in names(mutation_result)) {
if (cluster_key == "overall_divergence") next
cluster_result <- mutation_result[[cluster_key]]
if (!is.null(cluster_result$divergence)) {
summary_report <- rbind(
summary_report,
data.frame(
mutation = mutation,
cluster = gsub("cluster_", "", cluster_key),
num_approaches = length(cluster_result$comparison_data$standardized),
jaccard_avg = mean(cluster_result$divergence$jaccard_distances[upper.tri(
cluster_result$divergence$jaccard_distances)], na.rm = TRUE),
divergence_score = cluster_result$divergence$divergence_score,
stringsAsFactors = FALSE
)
)
}
}
}
# Save summary report
write.csv(summary_report, "summary_report.csv", row.names = FALSE)
}, error = function(e) {
cat(sprintf("Error generating summary: %s\n", e$message))
})
# Reset working directory
setwd(old_wd)
cat("Analysis complete. Results saved to", output_dir, "\n")
# Launch Shiny app if requested
if (launch_app && !is.null(results)) {
cat("Launching interactive Shiny app...\n")
launch_de_comparison_app(simplified_results, pd_gene_lists)
}
return(invisible(results))
}
