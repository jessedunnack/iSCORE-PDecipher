go_result <- tryCatch({
enrichGO(
gene = genes,
universe = background,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "ALL",
pAdjustMethod = "BH",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05
)
}, error = function(e) {
showNotification(paste("GO enrichment error:", e$message), type = "error")
return(NULL)
})
# Run KEGG enrichment
incProgress(0.5, detail = "Running KEGG enrichment")
# Convert gene symbols to ENTREZ IDs
gene_ids <- bitr(genes, fromType = "SYMBOL", toType = c("ENTREZID"), OrgDb = org.Hs.eg.db)
background_ids <- bitr(background, fromType = "SYMBOL", toType = c("ENTREZID"), OrgDb = org.Hs.eg.db)
# Remove NA values
gene_ids <- gene_ids[!is.na(gene_ids$ENTREZID),]
background_ids <- background_ids[!is.na(background_ids$ENTREZID),]
kegg_result <- tryCatch({
enrichKEGG(
gene = gene_ids$ENTREZID,
universe = background_ids$ENTREZID,
organism = "hsa",
pAdjustMethod = "BH",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05
)
}, error = function(e) {
showNotification(paste("KEGG enrichment error:", e$message), type = "error")
return(NULL)
})
# Store results in reactive values
rv$live_go_result <- go_result
rv$live_kegg_result <- kegg_result
} else {
# Run GSEA
gene_scores <- get_ranked_genes()
if (length(gene_scores) < 15) {
showNotification("Need at least 15 genes for GSEA", type = "error")
return(NULL)
}
# Convert to ENTREZ IDs for GSEA
incProgress(0.2, detail = "Converting gene IDs")
gene_ids_map <- bitr(names(gene_scores), fromType = "SYMBOL", toType = "ENTREZID", OrgDb = org.Hs.eg.db)
# Match gene scores with ENTREZ IDs
gene_scores_entrez <- gene_scores[names(gene_scores) %in% gene_ids_map$SYMBOL]
names(gene_scores_entrez) <- gene_ids_map$ENTREZID[match(names(gene_scores_entrez), gene_ids_map$SYMBOL)]
# Run GSEA for GO terms
incProgress(0.4, detail = "Running GSEA GO enrichment")
gsea_go_result <- tryCatch({
gseGO(
geneList = gene_scores_entrez,
OrgDb = org.Hs.eg.db,
ont = "ALL",
keyType = "ENTREZID",
pvalueCutoff = 0.05,
pAdjustMethod = "BH",
nPermSimple = 10000
)
}, error = function(e) {
showNotification(paste("GSEA GO error:", e$message), type = "error")
return(NULL)
})
# Run GSEA for KEGG
incProgress(0.7, detail = "Running GSEA KEGG enrichment")
gsea_kegg_result <- tryCatch({
gseKEGG(
geneList = gene_scores_entrez,
organism = "hsa",
keyType = "kegg",
pvalueCutoff = 0.05,
pAdjustMethod = "BH",
nPermSimple = 10000
)
}, error = function(e) {
showNotification(paste("GSEA KEGG error:", e$message), type = "error")
return(NULL)
})
# Store results in reactive values
rv$live_gsea_go_result <- gsea_go_result
rv$live_gsea_kegg_result <- gsea_kegg_result
}
incProgress(1.0, detail = "Done")
})
})
